{
  "name": "hive",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix client && npm install --prefix server",
    "client": "npm run start --prefix client",
    "server": "npm run dev --prefix server",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:all": "npm run test:e2e && npm run test:e2e:live",
    "test:client": "node scripts/test-client.cjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "browser:cli": "playwright-cli"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.22",
    "@playwright/test": "^1.63.0",
    "mongodb-memory-server": "^11.3.0"
  }
}
