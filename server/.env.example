# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/hive

# Auth (required)
JWT_SECRET_KEY=your-secret-key-here

# Allowed browser origin(s). Comma-separate for more than one; must match the
# Angular URL exactly (no quotes, no spaces around =).
CORS_ORIGIN=http://localhost:4200

# Optional: comma-separated host suffixes to also allow, for ephemeral preview
# deploys (e.g. .hive-web.pages.dev). Leave unset to allow only CORS_ORIGIN.
# CORS_ORIGIN_SUFFIXES=.pages.dev

# Optional
PORT=3000
NODE_ENV=development
# Cookie SameSite policy for auth cookie:
# - local dev (same-origin): lax
# - split-origin hosting (Pages + Render): none
# COOKIE_SAME_SITE=lax

# Cloudinary, email, Giphy — only if you use those features
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# GIPHY_API_KEY=

# Gmail SMTP used to send registration/password-reset OTP emails (required for OTP flows)
# EMAIL_USER=
# EMAIL_PASS=

# DM calls / chat realtime use GET /auth/realtime-token + Socket.IO (no extra keys)

# Optional TURN for DM WebRTC (strict NAT / corporate Wi-Fi)
# TURN_URL=turn:your-turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Phase 2 — LiveKit Cloud voicerooms (wss URL from LiveKit dashboard)
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
